# Copy to .env and fill in real values. Never commit .env.
#
# execution.mode stays "paper" in config/config.yaml regardless of what's
# set here UNLESS you also set ARBITRAGEX_ENABLE_LIVE_TRADING below to the
# exact confirmation string — see config.py's is_live_trading_authorized
# and docs/LIMITATIONS.md before ever doing that.

# --- Exchange API keys (sandbox/testnet keys recommended until fully tested) ---
BINANCE_API_KEY=
BINANCE_API_SECRET=
OKX_API_KEY=
OKX_API_SECRET=
KRAKEN_API_KEY=
KRAKEN_API_SECRET=

# --- DEX / on-chain ---
ETHEREUM_RPC_URL=
EXECUTION_WALLET_PRIVATE_KEY=
FLASH_ARB_CONTRACT_ADDRESS=

# --- Data layer ---
TIMESCALEDB_DSN=postgresql://arbx:arbx@localhost:5432/arbx
POSTGRES_DSN=postgresql://arbx:arbx@localhost:5432/arbx
REDIS_URL=redis://localhost:6379/0

# --- Message bus (only used if agents.message_bus.backend = rabbitmq) ---
RABBITMQ_URL=amqp://arbx:arbx@localhost:5672/
KAFKA_BOOTSTRAP_SERVERS=

# --- Compliance (scaffolding only — see docs/COMPLIANCE.md) ---
AML_KYC_API_KEY=

# --- Live trading confirmation — see the warning above. Leave unset. ---
ARBITRAGEX_ENABLE_LIVE_TRADING=
